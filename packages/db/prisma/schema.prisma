  releasedById    String?                @map("released_by_id")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  consumedAt      DateTime?              @map("consumed_at") @db.Timestamptz(3)
  releasedAt      DateTime?              @map("released_at") @db.Timestamptz(3)
  releaseReason   String?                @map("release_reason")

  orderItem     OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockLocation StockLocation   @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  createdBy     User            @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  consumedBy    User?           @relation("ReservationConsumedBy", fields: [consumedById], references: [id], onDelete: Restrict)
  releasedBy    User?           @relation("ReservationReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  movements     StockMovement[]

  @@index([orderItemId, status])
  @@index([productId, stockLocationId, status])
  @@map("stock_reservations")
}

