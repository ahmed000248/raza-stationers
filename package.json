{
  "name": "raza-stationers-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@raza-stationers/web",
    "dev:admin": "npm run dev --workspace=@raza-stationers/admin",
    "dev:mobile": "npm run dev --workspace=@raza-stationers/mobile",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:admin\" \"npm run dev:mobile\"",
    "build": "npm run build:runtime-packages && npm run build --workspaces --if-present",
    "build:runtime-packages": "npm run build --workspace=@raza-stationers/validation",
    "build:web": "npm run build --workspace=@raza-stationers/validation && npm run build --workspace=@raza-stationers/web",
    "build:admin": "npm run build --workspace=@raza-stationers/admin",
    "build:mobile": "npm run build --workspace=@raza-stationers/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5"
  },
  "dependencies": {
    "lucide-react": "^0.474.0"
  }
}
