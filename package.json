{
  "name": "raza-stationers-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@raza-stationers/web",
    "dev:admin": "npm run dev --workspace=@raza-stationers/admin",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@raza-stationers/web",
    "build:admin": "npm run build --workspace=@raza-stationers/admin",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "typescript": "^5"
  },
  "dependencies": {
    "lucide-react": "^1.26.0"
  }
}
