erDiagram
    PRODUCT ||--|{ PRODUCT_PACKAGING : sold_as
    PRODUCT ||--o{ STOCK_BALANCE : projected_for
    STOCK_LOCATION ||--o{ STOCK_BALANCE : contains
    ORDER_ITEM ||--o{ STOCK_RESERVATION : reserves
    PRODUCT ||--o{ STOCK_RESERVATION : base_unit_quantity
    STOCK_LOCATION ||--o{ STOCK_RESERVATION : held_at
    PRODUCT ||--o{ STOCK_MOVEMENT : moves
    STOCK_LOCATION ||--o{ STOCK_MOVEMENT : occurs_at
    STOCK_RESERVATION ||--o{ STOCK_MOVEMENT : consumed_or_released_by
    ORDER_ITEM ||--o{ STOCK_MOVEMENT : order_source
    CANCELLATION ||--o{ STOCK_MOVEMENT : reversal_source
    RETURN_ITEM ||--o{ STOCK_MOVEMENT : return_source
    DELIVERY_ATTEMPT ||--o{ STOCK_MOVEMENT : delivery_source

    PRODUCT {
        string id PK
        string sku UK
        ProductStatus status
    }
    PRODUCT_PACKAGING {
        string id PK
        string productId FK
        decimal conversionToBase "explicit"
        boolean isBase
    }
    STOCK_LOCATION {
        string id PK
        string code UK
        boolean isActive "only one active in v1"
    }
    STOCK_BALANCE {
        string id PK
        string productId FK
        string stockLocationId FK
        decimal onHandQuantity "sellable physical"
        decimal reservedQuantity "subset of onHand"
        decimal unavailableQuantity "packed or inspection pending"
        decimal inTransitQuantity "dispatched business-owned"
        decimal damagedQuantity "inspected damaged"
    }
    STOCK_RESERVATION {
        string id PK
        string orderItemId FK
        string productId FK
        string stockLocationId FK
        decimal quantityBase
        StockReservationStatus status
    }
    STOCK_MOVEMENT {
        string id PK
        string productId FK
        string stockLocationId FK
        decimal quantityBase
        StockBucket fromBucket
        StockBucket toBucket
        StockMovementType movementType
        string createdById FK
        datetime occurredAt
    }
    ORDER_ITEM {
        string id PK
        decimal baseQuantity
    }
    CANCELLATION {
        string id PK
        CancellationStatus status
    }
    RETURN_ITEM {
        string id PK
        decimal baseQuantity
        InventoryCondition condition
        StockBucket destination
    }
    DELIVERY_ATTEMPT {
        string id PK
        DeliveryAttemptStatus status
        InventoryCondition inspectionOutcome
    }

%% available is calculated as onHand - reserved and is not stored.
%% total business-owned inventory is onHand + unavailable + inTransit + damaged.
%% reserved is not added because it is already part of onHand.
%% Every quantity and movement uses the Product base unit.
%% Supplier, purchasing, purchase-order and goods-receipt systems are deferred
%% and intentionally omitted from the active Phase 4 v0.1 ERD.
