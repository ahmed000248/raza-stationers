# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
**/coverage/
**/*.test.log
tests/disposable_server.log

# next.js
.next/
out/

# production
build/
**/build/
**/dist/
**/graphify-out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files are local; templates are committed explicitly.
.env*
**/.env*
!.env.example
!apps/api/.env.example
!apps/web/.env.local.example
!apps/admin/.env.local.example

.env.production.verification
artifacts/production-verification/browser/

# Generated Prisma clients and temporary database artifacts
**/generated/prisma/
*.dump
*.sql.tmp
*.sqlite
*.sqlite3
*.db
compose.override.yaml
compose.override.yml
.docker.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large files and archives
*.zip
graphify-out/cache/


.codex-phase7-tmp/

tools/__pycache__/

graphify-out/
.gstack/
