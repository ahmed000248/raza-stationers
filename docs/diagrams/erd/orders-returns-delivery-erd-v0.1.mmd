    ORDER {
        string id PK
        string orderNumber UK
        OrderStatus status
        decimal grandTotal "14,2"
        datetime createdAt
    }
    ORDER_ITEM {
        string id PK
        string productId FK
        string productPackagingId FK
        decimal quantity
        decimal baseQuantity
        string skuSnapshot
        string productNameSnapshot
        decimal unitPriceSnapshot
        decimal lineTotalSnapshot
    }
    ORDER_STATUS_HISTORY {
        string id PK
        OrderStatus fromStatus
        OrderStatus toStatus
        string changedById FK
        datetime createdAt
    }
    ORDER_CHANGE_REQUEST {
        string id PK
        ChangeRequestType requestType
        ChangeRequestStatus status
        string requestedById FK
        string reviewedById FK
    }
    CANCELLATION {
        string id PK
        string orderId FK "unique"
        CancellationStatus status
        string requestedById FK
        string approvedById FK
        string stockConfirmedById FK
    }
    RETURN {
        string id PK
        string orderId FK
        string invoiceId FK
        ReturnStatus status
    }
    RETURN_ITEM {
        string id PK
        string orderItemId FK
        decimal quantity
        decimal baseQuantity
        InventoryCondition condition
        StockBucket destination
    }
    REFUND {
        string id PK
        RefundMethod method
        RefundStatus status
        decimal amount "14,2"
    }
    CREDIT_NOTE {
        string id PK
        string invoiceId FK
        string creditNoteNumber UK
        CreditNoteStatus status
        decimal amount "14,2"
    }
    DELIVERY {
        string id PK
        string orderId FK "unique"
        DeliveryStatus status
        string recipientConfirmation
        string notes
    }
    DELIVERY_ATTEMPT {
        string id PK
        string deliveryId FK
        int attemptNumber
        DeliveryAttemptStatus status
        string failureReason
        datetime dispatchAt
        datetime returnWarehouseAt
        InventoryCondition inspectionOutcome
        datetime completedAt
    }
    DELIVERY_ASSIGNMENT {
        string id PK
        string deliveryAttemptId FK
        string workerId FK
        string assignedById FK
        datetime assignedAt
        datetime endedAt
    }
    DELIVERY_ATTEMPT_STATUS_HISTORY {
        string id PK
        string deliveryAttemptId FK
        DeliveryAttemptStatus fromStatus
        DeliveryAttemptStatus toStatus
        string changedById FK
        boolean isOverride
        string reason
        datetime createdAt
    }

%% Packed/dispatched cancellations pass through return_pending_inspection.
%% Failed-delivery stock remains unavailable/in-transit until receipt and inspection.
%% DeliveryProof files are deferred; simple notes/recipient confirmation are allowed.
