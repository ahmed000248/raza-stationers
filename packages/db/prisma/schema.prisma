// Raza Stationers — Phase 4 physical schema, version 0.1.
//
// Product is the stock-distinguishing SKU. ProductPackaging describes the
// independently priced ways that the same base inventory can be sold.
// Category is intentionally flat in v0.1. Category hierarchy, Barcode, Brand,
// ProductImage, supplier/purchasing, file-upload and multi-warehouse workflows
// are deferred.
//
// Prisma expresses portable structure here. Conditional uniqueness, effective
// price-period exclusion, append-only protection and cross-row financial/stock
// invariants require future PostgreSQL constraints and NestJS transactions.
// No migration is generated as part of Phase 4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  admin
  packing
  delivery
  business_user

  @@map("user_role")
}

enum StaffRole {
  admin
  packing
  delivery

  @@map("staff_role")
}

enum BusinessType {
  stationery_shop
  school
  bookstore
  office
  distributor
  other

  @@map("business_type")
}

enum ClientBusinessAccountStatus {
  pending
  active
  suspended
  blocked
  archived

  @@map("client_business_account_status")
}

enum CreditStatus {
  active
  suspended
  blocked

  @@map("credit_status")
}

enum BusinessUserRole {
  owner
  manager
  purchase_officer
  branch_employee

  @@map("business_user_role")
}

/// Provisional source/import classification only. It never authorises a sale.
/// Sale eligibility is derived from Product status, ProductPackaging,
/// allowIndividualSale, confirmed conversion/UOM data and applicable price.
enum ProductPurchaseType {
  individual
  bulk
  both
  unconfirmed

  @@map("product_purchase_type")
}

enum ProductStatus {
  pending_review
  inactive
  active
  archived

  @@map("product_status")
}

enum ConfirmationStatus {
  unconfirmed
  confirmed
  rejected

  @@map("confirmation_status")
}

enum CurrencyCode {
  PKR

  @@map("currency_code")
}

enum PriceType {
  retail
  wholesale
  buying

  @@map("price_type")
}

enum DiscountScope {
  account_wide
  category
  product

  @@map("discount_scope")
}

enum ApprovalDecision {
  approved
  rejected
  more_information_required

  @@map("approval_decision")
}

enum OrderStatus {
  pending_review
  pending_owner_approval
  confirmed
  change_requested
  packed
  out_for_delivery
  failed_delivery
  return_pending_inspection
  delivered
  cancelled
  rejected

  @@map("order_status")
}

enum ChangeRequestType {
  edit
  cancellation

  @@map("change_request_type")
}

enum ChangeRequestStatus {
  pending
  approved
  rejected
  withdrawn

  @@map("change_request_status")
}

enum CancellationStatus {
  requested
  approved
  pending_stock_inspection
  completed
  rejected

  @@map("cancellation_status")
}

enum InvoiceStatus {
  issued
  partially_paid
  paid
  credited
  voided

  @@map("invoice_status")
}

enum DocumentType {
  order
  invoice
  credit_note

  @@map("document_type")
}

enum CreditNoteStatus {
  pending_approval
  approved
  issued
  voided

  @@map("credit_note_status")
}

enum CreditNoteSourceType {
  cancellation
  return
  manual_adjustment

  @@map("credit_note_source_type")
}

enum PaymentMethod {
  cash
  bank_transfer
  easypaisa
  jazzcash
  cash_on_delivery

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  submitted
  verified
  rejected
  voided

  @@map("payment_status")
}

enum CreditLedgerEntryType {
  overpayment_credit
  refund_credit
  manual_credit_adjustment
  reversal_credit
  credit_applied
  credit_payout
  manual_debit_adjustment
  reversal_debit

  @@map("credit_ledger_entry_type")
}

enum RefundMethod {
  cash
  bank_transfer
  easypaisa
  jazzcash
  cash_on_delivery
  client_credit

  @@map("refund_method")
}

enum RefundStatus {
  pending_approval
  approved
  processed
  rejected
  voided

  @@map("refund_status")
}

enum StockBucket {
  sellable
  unavailable
  in_transit
  damaged
  external

  @@map("stock_bucket")
}

enum StockMovementType {
  restock
  packing
  dispatch
  delivery
  return_receipt
  inspection_release
  damage_transfer
  cancellation_reversal
  adjustment

  @@map("stock_movement_type")
}

enum StockReservationStatus {
  active
  consumed
  released

  @@map("stock_reservation_status")
}

enum InventoryCondition {
  pending_inspection
  sellable
  damaged
  quarantined

  @@map("inventory_condition")
}

enum ReturnStatus {
  requested
  approved
  awaiting_inspection
  inspected
  completed
  rejected
  voided

  @@map("return_status")
}

enum DeliveryStatus {
  pending
  active
  delivered
  failed
  returning
  cancelled

  @@map("delivery_status")
}

enum DeliveryAttemptStatus {
  assigned
  dispatched
  delivered
  failed
  returning_to_warehouse
  returned_to_warehouse
  cancelled

  @@map("delivery_attempt_status")
}

enum ImportBatchStatus {
  uploaded
  validating
  preview_ready
  approved
  committing
  committed
  failed
  cancelled

  @@map("import_batch_status")
}

enum ImportValidationStatus {
  pending
  valid
  warning
  invalid

  @@map("import_validation_status")
}

enum ImportCommitStatus {
  pending
  approved
  imported
  skipped
  failed

  @@map("import_commit_status")
}

enum ImportIssueSeverity {
  warning
  error

  @@map("import_issue_severity")
}

enum ExpenseCategory {
  restocking
  salaries
  rent
  utilities
  fuel
  vehicle_maintenance
  packaging
  gateway_fees
  returns_refunds
  damaged_stock
  taxes
  other

  @@map("expense_category")
}

enum NotificationSubscriptionScope {
  product
  category

  @@map("notification_subscription_scope")
}

enum NotificationType {
  restock
  order_status
  payment_reminder
  credit_status
  account_status
  announcement

  @@map("notification_type")
}

model User {
  id              String    @id @default(cuid())
  mobileNumber    String    @unique @map("mobile_number")
  email           String?   @unique
  passwordHash    String?   @map("password_hash")
  name            String
  role            UserRole
  isActive        Boolean   @default(true) @map("is_active")
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz(3)
  deactivatedById String?   @map("deactivated_by_id")
  totpSecret      String?   @map("totp_secret") // Deprecated: Custom speakeasy TOTP secret (unused, superseded by Supabase MFA)
  isTotpEnabled   Boolean   @default(false) @map("is_totp_enabled") // Deprecated: Custom speakeasy TOTP status (unused, superseded by Supabase MFA)
  supabaseAuthId  String?   @unique @map("supabase_auth_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  deactivatedBy               User?                          @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: Restrict)
  deactivatedUsers            User[]                         @relation("UserDeactivatedBy")
  staffProfile                StaffProfile?
  businessUserLinks           BusinessUserLink[]             @relation("BusinessLinkedUser")
  businessLinksCreated        BusinessUserLink[]             @relation("BusinessLinkCreatedBy")
  businessLinksEnded          BusinessUserLink[]             @relation("BusinessLinkEndedBy")
  businessApprovals           ClientBusinessApproval[]
  businessesArchived          ClientBusiness[]               @relation("ClientBusinessArchivedBy")
  categoriesArchived          Category[]                     @relation("CategoryArchivedBy")
  productsActivated           Product[]                      @relation("ProductActivatedBy")
  productsArchived            Product[]                      @relation("ProductArchivedBy")
  productPricesCreated        ProductPrice[]
  clientPricesCreated         ClientSpecificPrice[]
  discountRulesCreated        DiscountRule[]
  discountChanges             DiscountChangeLog[]
  creditLimitChanges          ClientCreditLimitChange[]
  orderCreditApprovals        OrderCreditApproval[]
  ordersPlaced                Order[]
  orderStatusChanges          OrderStatusHistory[]
  changeRequestsCreated       OrderChangeRequest[]           @relation("ChangeRequestRequestedBy")
  changeRequestsReviewed      OrderChangeRequest[]           @relation("ChangeRequestReviewedBy")
  cancellationsRequested      Cancellation[]                 @relation("CancellationRequestedBy")
  cancellationsApproved       Cancellation[]                 @relation("CancellationApprovedBy")
  cancellationsStockConfirmed Cancellation[]                 @relation("CancellationStockConfirmedBy")
  invoicesIssued              Invoice[]
  creditNotesApproved         CreditNote[]                   @relation("CreditNoteApprovedBy")
  creditNotesIssued           CreditNote[]                   @relation("CreditNoteIssuedBy")
  paymentsSubmitted           Payment[]                      @relation("PaymentSubmittedBy")
  paymentsVerified            Payment[]                      @relation("PaymentVerifiedBy")
  allocationsCreated          PaymentAllocation[]            @relation("AllocationCreatedBy")
  allocationsReversed         PaymentAllocation[]            @relation("AllocationReversedBy")
  creditEntriesCreated        CreditLedgerEntry[]
  refundsRequested            Refund[]                       @relation("RefundRequestedBy")
  refundsApproved             Refund[]                       @relation("RefundApprovedBy")
  refundsProcessed            Refund[]                       @relation("RefundProcessedBy")
  stockLocationsArchived      StockLocation[]                @relation("StockLocationArchivedBy")
  reservationsCreated         StockReservation[]             @relation("ReservationCreatedBy")
  reservationsConsumed        StockReservation[]             @relation("ReservationConsumedBy")
  reservationsReleased        StockReservation[]             @relation("ReservationReleasedBy")
  stockMovementsCreated       StockMovement[]
  returnsRequested            Return[]                       @relation("ReturnRequestedBy")
  returnsApproved             Return[]                       @relation("ReturnApprovedBy")
  returnsInspected            Return[]                       @relation("ReturnInspectedBy")
  returnsCompleted            Return[]                       @relation("ReturnCompletedBy")
  returnItemsInspected        ReturnItem[]
  attemptsInspected           DeliveryAttempt[]
  deliveryAssignments         DeliveryAssignment[]           @relation("DeliveryAssignedWorker")
  deliveryAssignmentsMade     DeliveryAssignment[]           @relation("DeliveryAssignedBy")
  deliveryStatusChanges       DeliveryAttemptStatusHistory[]
  importBatchesUploaded       ImportBatch[]                  @relation("ImportUploadedBy")
  importBatchesApproved       ImportBatch[]                  @relation("ImportApprovedBy")
  importBatchesCommitted      ImportBatch[]                  @relation("ImportCommittedBy")
  importIssuesResolved        ImportIssue[]
  expensesCreated             ExpenseEntry[]                 @relation("ExpenseCreatedBy")
  expensesVoided              ExpenseEntry[]                 @relation("ExpenseVoidedBy")
  notificationSubscriptions   NotificationSubscription[]
  notifications               Notification[]
  auditLogs                   AuditLog[]

  @@map("users")
}

model StaffProfile {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  staffRole StaffRole @map("staff_role")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("staff_profiles")
}

model ClientBusiness {
  id            String                      @id @default(cuid())
  businessName  String                      @map("business_name")
  businessType  BusinessType                @map("business_type")
  contactPerson String                      @map("contact_person")
  mobileNumber  String                      @map("mobile_number")
  email         String?
  ntn           String?
  cnic          String?
  address       String
  city          String
  accountStatus ClientBusinessAccountStatus @default(pending) @map("account_status")
  archivedAt    DateTime?                   @map("archived_at") @db.Timestamptz(3)
  archivedById  String?                     @map("archived_by_id")
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  archivedBy    User?                    @relation("ClientBusinessArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  userLinks     BusinessUserLink[]
  approvals     ClientBusinessApproval[]
  creditAccount ClientCreditAccount?
  clientPrices  ClientSpecificPrice[]
  discountRules DiscountRule[]
  orders        Order[]
  invoices      Invoice[]
  payments      Payment[]
  refunds       Refund[]

  @@index([accountStatus])
  @@index([businessName])
  @@index([mobileNumber])
  @@map("client_businesses")
}

model BusinessUserLink {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  clientBusinessId String           @map("client_business_id")
  role             BusinessUserRole
  linkedById       String           @map("linked_by_id")
  endedById        String?          @map("ended_by_id")
  linkedAt         DateTime         @default(now()) @map("linked_at") @db.Timestamptz(3)
  endedAt          DateTime?        @map("ended_at") @db.Timestamptz(3)

  user           User           @relation("BusinessLinkedUser", fields: [userId], references: [id], onDelete: Restrict)
  clientBusiness ClientBusiness @relation(fields: [clientBusinessId], references: [id], onDelete: Restrict)
  linkedBy       User           @relation("BusinessLinkCreatedBy", fields: [linkedById], references: [id], onDelete: Restrict)
  endedBy        User?          @relation("BusinessLinkEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([userId, endedAt])
  @@index([clientBusinessId, endedAt])
  @@map("business_user_links")
}

model ClientBusinessApproval {
  id               String           @id @default(cuid())
  clientBusinessId String           @map("client_business_id")
  decision         ApprovalDecision
  decidedById      String           @map("decided_by_id")
  reason           String
  decidedAt        DateTime         @default(now()) @map("decided_at") @db.Timestamptz(3)

  clientBusiness ClientBusiness @relation(fields: [clientBusinessId], references: [id], onDelete: Restrict)
  decidedBy      User           @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([clientBusinessId, decidedAt])
  @@map("client_business_approvals")
}

/// Optional: a business has no row until credit is configured/approved.
model ClientCreditAccount {
  id               String       @id @default(cuid())
  clientBusinessId String       @unique @map("client_business_id")
  creditLimit      Decimal      @map("credit_limit") @db.Decimal(14, 2)
  creditDays       Int          @default(0) @map("credit_days")
  status           CreditStatus @default(active)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientBusiness ClientBusiness            @relation(fields: [clientBusinessId], references: [id], onDelete: Restrict)
  limitChanges   ClientCreditLimitChange[]
  ledgerEntries  CreditLedgerEntry[]
  orderApprovals OrderCreditApproval[]

  @@map("client_credit_accounts")
}

model ClientCreditLimitChange {
  id                    String   @id @default(cuid())
  clientCreditAccountId String   @map("client_credit_account_id")
  oldLimit              Decimal  @map("old_limit") @db.Decimal(14, 2)
  newLimit              Decimal  @map("new_limit") @db.Decimal(14, 2)
  oldCreditDays         Int      @map("old_credit_days")
  newCreditDays         Int      @map("new_credit_days")
  approvedById          String   @map("approved_by_id")
  reason                String
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clientCreditAccount ClientCreditAccount @relation(fields: [clientCreditAccountId], references: [id], onDelete: Restrict)
  approvedBy          User                @relation(fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([clientCreditAccountId, createdAt])
  @@map("client_credit_limit_changes")
}

/// Flat category only. Parent/category-tree fields are intentionally deferred.
model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  isActive     Boolean   @default(true) @map("is_active")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  archivedById String?   @map("archived_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  archivedBy                User?                      @relation("CategoryArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  products                  Product[]
  discountRules             DiscountRule[]
  notificationSubscriptions NotificationSubscription[]
  sourceMappings            SourceRecordMapping[]

  @@index([isActive, name])
  @@map("categories")
}

model Product {
  id                     String              @id @default(cuid())
  skuNumber              BigInt              @unique @map("sku_number")
  sku                    String              @unique
  name                   String
  nameUrdu               String?             @map("name_urdu")
  shopName               String?             @map("shop_name")
  categoryId             String              @map("category_id")
  description            String?
  purchaseType           ProductPurchaseType @default(unconfirmed) @map("purchase_type")
  status                 ProductStatus       @default(pending_review)
  unitConfirmationStatus ConfirmationStatus  @default(unconfirmed) @map("unit_confirmation_status")
  allowIndividualSale    Boolean             @default(false) @map("allow_individual_sale")
  lowStockThresholdBase  Decimal?            @map("low_stock_threshold_base") @db.Decimal(18, 3)
  openingStockStatus     String              @default("NOT_COUNTED") @map("opening_stock_status")
  reviewReason           String?             @map("review_reason")
  activatedAt            DateTime?           @map("activated_at") @db.Timestamptz(3)
  activatedById          String?             @map("activated_by_id")
  archivedAt             DateTime?           @map("archived_at") @db.Timestamptz(3)
  archivedById           String?             @map("archived_by_id")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  category                  Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  activatedBy               User?                      @relation("ProductActivatedBy", fields: [activatedById], references: [id], onDelete: Restrict)
  archivedBy                User?                      @relation("ProductArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  aliases                   ProductAlias[]
  packaging                 ProductPackaging[]
  stockBalances             StockBalance[]
  stockReservations         StockReservation[]
  stockMovements            StockMovement[]
  discountRules             DiscountRule[]
  orderItems                OrderItem[]
  notificationSubscriptions NotificationSubscription[]
  sourceMappings            SourceRecordMapping[]

  @@index([status, categoryId])
  @@index([name])
  @@index([shopName])
  @@map("products")
}

model ProductAlias {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  alias           String
  normalizedAlias String   @map("normalized_alias")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, normalizedAlias])
  @@index([normalizedAlias])
  @@map("product_aliases")
}

model UnitOfMeasure {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  symbol           String?
  allowsFractional Boolean  @default(false) @map("allows_fractional")
  decimalScale     Int      @default(0) @map("decimal_scale")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  packaging ProductPackaging[]

  @@map("units_of_measure")
}

model ProductPackaging {
  id                 String             @id @default(cuid())
  productId          String             @map("product_id")
  unitOfMeasureId    String             @map("unit_of_measure_id")
  code               String
  label              String
  conversionToBase   Decimal            @map("conversion_to_base") @db.Decimal(18, 6)
  packQuantity       Int?               @map("pack_quantity")
  isBase             Boolean            @default(false) @map("is_base")
  confirmationStatus ConfirmationStatus @default(unconfirmed) @map("confirmation_status")
  isActive           Boolean            @default(false) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitOfMeasure  UnitOfMeasure         @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  prices         ProductPrice[]
  clientPrices   ClientSpecificPrice[]
  orderItems     OrderItem[]
  sourceMappings SourceRecordMapping[]

  @@unique([productId, code])
  @@index([productId, isBase])
  @@index([unitOfMeasureId])
  @@map("product_packaging")
}

model ProductPrice {
  id                 String       @id @default(cuid())
  productPackagingId String       @map("product_packaging_id")
  priceType          PriceType    @map("price_type")
  currency           CurrencyCode @default(PKR)
  amount             Decimal      @db.Decimal(14, 2)
  effectiveFrom      DateTime     @map("effective_from") @db.Timestamptz(3)
  effectiveTo        DateTime?    @map("effective_to") @db.Timestamptz(3)
  createdById        String       @map("created_by_id")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  productPackaging ProductPackaging      @relation(fields: [productPackagingId], references: [id], onDelete: Restrict)
  createdBy        User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sourceMappings   SourceRecordMapping[]

  @@index([productPackagingId, priceType, currency, effectiveFrom])
  @@map("product_prices")
}

model ClientSpecificPrice {
  id                 String       @id @default(cuid())
  clientBusinessId   String       @map("client_business_id")
  productPackagingId String       @map("product_packaging_id")
  currency           CurrencyCode @default(PKR)
  amount             Decimal      @db.Decimal(14, 2)
  effectiveFrom      DateTime     @map("effective_from") @db.Timestamptz(3)
  effectiveTo        DateTime?    @map("effective_to") @db.Timestamptz(3)
  createdById        String       @map("created_by_id")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  clientBusiness   ClientBusiness   @relation(fields: [clientBusinessId], references: [id], onDelete: Restrict)
  productPackaging ProductPackaging @relation(fields: [productPackagingId], references: [id], onDelete: Restrict)
  createdBy        User             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([clientBusinessId, productPackagingId, currency, effectiveFrom])
  @@map("client_specific_prices")
}

model DiscountRule {
  id               String        @id @default(cuid())
  clientBusinessId String        @map("client_business_id")
  scope            DiscountScope
  categoryId       String?       @map("category_id")
  productId        String?       @map("product_id")
  discountPercent  Decimal       @map("discount_percent") @db.Decimal(5, 2)
  isActive         Boolean       @default(true) @map("is_active")
  createdById      String        @map("created_by_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientBusiness ClientBusiness      @relation(fields: [clientBusinessId], references: [id], onDelete: Restrict)
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  product        Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy      User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  changeLogs     DiscountChangeLog[]

  @@index([clientBusinessId, scope, isActive])
  @@index([categoryId])
  @@index([productId])
  @@map("discount_rules")
}

model DiscountChangeLog {
  id             String   @id @default(cuid())
  discountRuleId String   @map("discount_rule_id")
  oldPercent     Decimal? @map("old_percent") @db.Decimal(5, 2)
  newPercent     Decimal? @map("new_percent") @db.Decimal(5, 2)
  changedById    String   @map("changed_by_id")
  reason         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: Restrict)
  changedBy    User         @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([discountRuleId, createdAt])
  @@map("discount_change_logs")
}

/// One active location is allowed in v0.1; a future PostgreSQL partial unique
/// index enforces that rule while the model remains multi-location capable.
model StockLocation {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  isActive     Boolean   @default(false) @map("is_active")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  archivedById String?   @map("archived_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  archivedBy   User?              @relation("StockLocationArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  balances     StockBalance[]
  reservations StockReservation[]
  movements    StockMovement[]

  @@index([isActive])
  @@map("stock_locations")
}

/// All quantities use the Product base unit.
/// onHand: sellable physical stock at the location.
/// reserved: subset of onHand committed to active reservations.
/// unavailable: packed/returned stock not currently sellable and not dispatched.
/// inTransit: dispatched business-owned stock outside the warehouse.
/// damaged: inspected business-owned damaged stock.
/// available is calculated, never stored: onHand - reserved.
/// Total business-owned inventory is onHand + unavailable + inTransit + damaged;
/// reserved is not added because it is already a subset of onHand.
model StockBalance {
  id                  String   @id @default(cuid())
  productId           String   @map("product_id")
  stockLocationId     String   @map("stock_location_id")
  onHandQuantity      Decimal  @default(0) @map("on_hand_quantity") @db.Decimal(18, 3)
  reservedQuantity    Decimal  @default(0) @map("reserved_quantity") @db.Decimal(18, 3)
  unavailableQuantity Decimal  @default(0) @map("unavailable_quantity") @db.Decimal(18, 3)
  inTransitQuantity   Decimal  @default(0) @map("in_transit_quantity") @db.Decimal(18, 3)
  damagedQuantity     Decimal  @default(0) @map("damaged_quantity") @db.Decimal(18, 3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)

  @@unique([productId, stockLocationId])
  @@index([stockLocationId])
  @@map("stock_balances")
}

model StockReservation {
  id              String                 @id @default(cuid())
  orderItemId     String                 @map("order_item_id")
  productId       String                 @map("product_id")
  stockLocationId String                 @map("stock_location_id")
