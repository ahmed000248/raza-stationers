erDiagram
    USER ||--o{ BUSINESS_USER_LINK : linked_history
    CLIENT_BUSINESS ||--o{ BUSINESS_USER_LINK : has_users
    CLIENT_BUSINESS ||--o{ CLIENT_BUSINESS_APPROVAL : reviewed
    CLIENT_BUSINESS ||--o| CLIENT_CREDIT_ACCOUNT : optionally_has
    CLIENT_CREDIT_ACCOUNT ||--o{ CLIENT_CREDIT_LIMIT_CHANGE : limit_history
    CLIENT_CREDIT_ACCOUNT ||--o{ ORDER_CREDIT_APPROVAL : exception_history
    CLIENT_CREDIT_ACCOUNT ||--o{ CREDIT_LEDGER_ENTRY : derives_credit_balance
    CLIENT_BUSINESS ||--o{ ORDER : places
    ORDER ||--o| ORDER_CREDIT_APPROVAL : may_require
    ORDER ||--o| INVOICE : invoiced_once
    CLIENT_BUSINESS ||--o{ PAYMENT : submits
    PAYMENT ||--o{ PAYMENT_ALLOCATION : allocated_by
    INVOICE ||--o{ PAYMENT_ALLOCATION : allocated_to
    INVOICE ||--o{ CREDIT_NOTE : adjusted_by
    CREDIT_NOTE ||--o{ REFUND : may_create
    PAYMENT ||--o{ REFUND : original_method
    REFUND ||--o{ CREDIT_LEDGER_ENTRY : may_credit

    CLIENT_BUSINESS {
        string id PK
        string businessName
        string email "optional"
        string ntn "optional"
        string cnic "optional"
        string accountStatus
        datetime archivedAt
    }
    BUSINESS_USER_LINK {
        string id PK
        string userId FK
        string clientBusinessId FK
        datetime linkedAt
        datetime endedAt
    }
    CLIENT_CREDIT_ACCOUNT {
        string id PK
        string clientBusinessId FK "unique optional relation"
        decimal creditLimit "14,2"
        int creditDays
        CreditStatus status
    }
    INVOICE {
        string id PK
        string orderId FK "unique"
        string invoiceNumber UK "RS-INV-YYYY-000001"
        decimal totalAmount "14,2"
        datetime issuedAt
        datetime dueAt
    }
    PAYMENT {
        string id PK
        PaymentMethod method
        PaymentStatus status
        decimal amount "14,2"
    }
    PAYMENT_ALLOCATION {
        string id PK
        string paymentId FK
        string invoiceId FK
        decimal amount "14,2"
        datetime allocatedAt
        datetime reversedAt
    }
    CREDIT_LEDGER_ENTRY {
        string id PK
        string clientCreditAccountId FK
        CreditLedgerEntryType entryType
        decimal amount "signed 14,2"
        datetime createdAt
    }
    CREDIT_NOTE {
        string id PK
        string invoiceId FK
        string cancellationId FK "nullable"
        string returnId FK "nullable"
        CreditNoteSourceType sourceType
        string creditNoteNumber UK
        decimal amount "14,2"
        CreditNoteStatus status
    }
    REFUND {
        string id PK
        RefundMethod method
        RefundStatus status
        decimal amount "14,2"
        string approvedById FK
        string processedById FK
    }

  %% Credit is optional: ClientBusiness to ClientCreditAccount is 0..1.
  %% CreditLedgerEntry is signed customer/store credit only; its sum is usable store credit.
  %% Invoice debt is calculated separately from Invoice, non-reversed allocations and CreditNote.
  %% Unverified payments do not change Invoice or client-credit balances.
%% Allocation reconfiguration reverses rows and adds replacements; history stays.
