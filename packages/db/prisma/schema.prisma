  currency                   CurrencyCode @default(PKR)
  isFree                     Boolean      @default(false) @map("is_free")
  requiresManualConfirmation Boolean      @default(true) @map("requires_manual_confirmation")
  isActive                   Boolean      @default(false) @map("is_active")
  createdAt                  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries Delivery[]

  @@index([city, isActive])
  @@map("delivery_zones")
}

model Delivery {
  id                    String         @id @default(cuid())
  orderId               String         @unique @map("order_id")
  deliveryZoneId        String?        @map("delivery_zone_id")
  status                DeliveryStatus @default(pending)
  recipientNameSnapshot String         @map("recipient_name_snapshot")
  mobileSnapshot        String         @map("mobile_snapshot")
  addressSnapshot       String         @map("address_snapshot")
  recipientConfirmation String?        @map("recipient_confirmation")
  notes                 String?
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order        Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  deliveryZone DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  attempts     DeliveryAttempt[]

  @@index([status, createdAt])
  @@map("deliveries")
}

model DeliveryAttempt {
  id                String                @id @default(cuid())
  deliveryId        String                @map("delivery_id")
  attemptNumber     Int                   @map("attempt_number")
  status            DeliveryAttemptStatus @default(assigned)
  failureReason     String?               @map("failure_reason")
  dispatchAt        DateTime?             @map("dispatch_at") @db.Timestamptz(3)
  returnWarehouseAt DateTime?             @map("return_warehouse_at") @db.Timestamptz(3)
  inspectionOutcome InventoryCondition?   @map("inspection_outcome")
  inspectedById     String?               @map("inspected_by_id")
  inspectedAt       DateTime?             @map("inspected_at") @db.Timestamptz(3)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery      Delivery                       @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  inspectedBy   User?                          @relation(fields: [inspectedById], references: [id], onDelete: Restrict)
  assignments   DeliveryAssignment[]
  statusHistory DeliveryAttemptStatusHistory[]
  movements     StockMovement[]

  @@unique([deliveryId, attemptNumber])
  @@index([status, createdAt])
  @@map("delivery_attempts")
}

model DeliveryAssignment {
  id                String    @id @default(cuid())
  deliveryAttemptId String    @map("delivery_attempt_id")
  workerId          String    @map("worker_id")
  assignedById      String    @map("assigned_by_id")
  reason            String?
  assignedAt        DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt           DateTime? @map("ended_at") @db.Timestamptz(3)

  deliveryAttempt DeliveryAttempt @relation(fields: [deliveryAttemptId], references: [id], onDelete: Restrict)
  worker          User            @relation("DeliveryAssignedWorker", fields: [workerId], references: [id], onDelete: Restrict)
  assignedBy      User            @relation("DeliveryAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([deliveryAttemptId, endedAt])
  @@index([workerId, endedAt])
  @@map("delivery_assignments")
}

model DeliveryAttemptStatusHistory {
  id                String                 @id @default(cuid())
  deliveryAttemptId String                 @map("delivery_attempt_id")
  fromStatus        DeliveryAttemptStatus? @map("from_status")
  toStatus          DeliveryAttemptStatus  @map("to_status")
  changedById       String                 @map("changed_by_id")
  isOverride        Boolean                @default(false) @map("is_override")
  reason            String?
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  deliveryAttempt DeliveryAttempt @relation(fields: [deliveryAttemptId], references: [id], onDelete: Restrict)
  changedBy       User            @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([deliveryAttemptId, createdAt])
  @@map("delivery_attempt_status_history")
}

model ImportBatch {
  id               String            @id @default(cuid())
  originalFilename String            @map("original_filename")
  sha256           String            @db.VarChar(64)
  status           ImportBatchStatus @default(uploaded)
  totalRows        Int               @default(0) @map("total_rows")
  validRows        Int               @default(0) @map("valid_rows")
  warningRows      Int               @default(0) @map("warning_rows")
  invalidRows      Int               @default(0) @map("invalid_rows")
  uploadedById     String            @map("uploaded_by_id")
  approvedById     String?           @map("approved_by_id")
  committedById    String?           @map("committed_by_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedAt       DateTime?         @map("approved_at") @db.Timestamptz(3)
  committedAt      DateTime?         @map("committed_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedBy  User        @relation("ImportUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  approvedBy  User?       @relation("ImportApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  committedBy User?       @relation("ImportCommittedBy", fields: [committedById], references: [id], onDelete: Restrict)
  rows        ImportRow[]

  @@index([sha256, status])
  @@index([status, createdAt])
  @@map("import_batches")
}

model ImportRow {
  id               String                 @id @default(cuid())
  importBatchId    String                 @map("import_batch_id")
  sourceSheet      String                 @map("source_sheet")
  sourceRowNumber  Int                    @map("source_row_number")
  rawData          Json                   @map("raw_data")
  normalizedData   Json?                  @map("normalized_data")
  validationStatus ImportValidationStatus @default(pending) @map("validation_status")
  commitStatus     ImportCommitStatus     @default(pending) @map("commit_status")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  importBatch    ImportBatch           @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  issues         ImportIssue[]
  sourceMappings SourceRecordMapping[]

  @@unique([importBatchId, sourceSheet, sourceRowNumber])
  @@index([importBatchId, validationStatus, commitStatus])
  @@map("import_rows")
}

model ImportIssue {
  id           String              @id @default(cuid())
  importRowId  String              @map("import_row_id")
  severity     ImportIssueSeverity
  code         String
  fieldName    String?             @map("field_name")
  message      String
  resolvedById String?             @map("resolved_by_id")
  resolution   String?
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt   DateTime?           @map("resolved_at") @db.Timestamptz(3)

  importRow  ImportRow @relation(fields: [importRowId], references: [id], onDelete: Restrict)
  resolvedBy User?     @relation(fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([importRowId, severity])
  @@map("import_issues")
}

/// A future PostgreSQL CHECK ensures exactly one canonical target is populated.
model SourceRecordMapping {
  id                 String   @id @default(cuid())
  importRowId        String   @map("import_row_id")
  sourceSystem       String   @map("source_system")
  sourceKey          String   @map("source_key")
  categoryId         String?  @map("category_id")
  productId          String?  @map("product_id")
  productPackagingId String?  @map("product_packaging_id")
  productPriceId     String?  @map("product_price_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  importRow        ImportRow         @relation(fields: [importRowId], references: [id], onDelete: Restrict)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  product          Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  productPackaging ProductPackaging? @relation(fields: [productPackagingId], references: [id], onDelete: Restrict)
  productPrice     ProductPrice?     @relation(fields: [productPriceId], references: [id], onDelete: Restrict)

  @@unique([sourceSystem, sourceKey])
  @@index([importRowId])
  @@index([categoryId])
  @@index([productId])
  @@index([productPackagingId])
  @@index([productPriceId])
  @@map("source_record_mappings")
}

model ExpenseEntry {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  currency    CurrencyCode    @default(PKR)
  description String
  expenseAt   DateTime        @map("expense_at") @db.Timestamptz(3)
  createdById String          @map("created_by_id")
  voidedById  String?         @map("voided_by_id")
  voidReason  String?         @map("void_reason")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt    DateTime?       @map("voided_at") @db.Timestamptz(3)

  createdBy User  @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy  User? @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([expenseAt])
  @@map("expense_entries")
}

model NotificationSubscription {
  id         String                        @id @default(cuid())
  userId     String                        @map("user_id")
  scope      NotificationSubscriptionScope
  productId  String?                       @map("product_id")
  categoryId String?                       @map("category_id")
  isActive   Boolean                       @default(true) @map("is_active")
  createdAt  DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, scope, isActive])
  @@index([productId])
  @@index([categoryId])
  @@map("notification_subscriptions")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  readAt     DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// AuditLog models the required append-only record. Prisma cannot force an
/// audit row to be created or redact sensitive JSON. Those protections remain
/// future NestJS transaction/serializer, authorization and PostgreSQL work.
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String   @map("actor_id")
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  reason        String?
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model BusinessSettings {
  id              String  @id @default(cuid())
  businessName    String  @default("Raza Stationers") @map("business_name")
  contactPhone    String  @default("042-35678901") @map("contact_phone")
  requireApproval Boolean @default(true) @map("require_approval")
  stockAlert      Boolean @default(true) @map("stock_alert")
  packingView     Boolean @default(true) @map("packing_view")
  inventoryMode   String  @default("DEMO") @map("inventory_mode")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}
